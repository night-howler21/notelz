# Browser-safe Supabase settings from the project Connect dialog.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-or-hosted-publishable-key

# Server-only key. Never prefix this with NEXT_PUBLIC_ or expose it to the browser.
SUPABASE_SECRET_KEY=replace-with-local-or-hosted-secret-key

# Used only by `npm run migrate:legacy`.
LEGACY_DATABASE_URL=postgresql://notelz:notelz@localhost:5432/notelz
SUPABASE_DB_URL=postgresql://postgres:postgres@localhost:54322/postgres
